generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String        @id @default(uuid())
  workoutPlans        WorkoutPlan[]
  name                String
  email               String
  emailVerified       Boolean       @default(false)
  image               String?
  createdAt           DateTime      @default(now()) @db.Timestamptz
  updatedAt           DateTime      @updatedAt @db.Timestamptz
  sessions            Session[]
  accounts            Account[]
  weightInGrams       Int?
  heightInCentimeters Int?
  age                 Int?
  bodyFatPercentage   Int? // 100 representa 100% 

  @@unique([email])
  @@map("user")
}

model WorkoutPlan {
  id          String       @id @default(uuid())
  name        String
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now()) @db.Timestamptz
  updatedAt   DateTime     @updatedAt @db.Timestamptz
  workoutDays WorkoutDay[]
}

enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model WorkoutDay {
  id                       String               @id @default(uuid())
  name                     String
  workoutPlanId            String
  workoutPlan              WorkoutPlan          @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)
  isRest                   Boolean              @default(false)
  weekDay                  WeekDay
  estimatedDurationSeconds Int
  createdAt                DateTime             @default(now()) @db.Timestamptz
  updatedAt                DateTime             @updatedAt @db.Timestamptz
  workoutExercises         WorkoutExercise[]
  userWorkoutSessions      UserWorkoutSession[]
}

model WorkoutExercise {
  id              String     @id @default(uuid())
  order           Int
  name            String
  sets            Int
  reps            Int
  restTimeSeconds Int
  workoutDayId    String
  workoutDay      WorkoutDay @relation(fields: [workoutDayId], references: [id], onDelete: Cascade)
  createdAt       DateTime   @default(now()) @db.Timestamptz
  updatedAt       DateTime   @updatedAt
}

model UserWorkoutSession {
  id           String     @id @default(uuid())
  userId       String
  workoutDayId String
  workoutDay   WorkoutDay @relation(fields: [workoutDayId], references: [id], onDelete: Cascade)
  startAt      DateTime   @db.Timestamptz
  completedAt  DateTime   @db.Timestamptz
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz
  updatedAt             DateTime  @updatedAt @db.Timestamptz

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @updatedAt @db.Timestamptz

  @@index([identifier])
  @@map("verification")
}
